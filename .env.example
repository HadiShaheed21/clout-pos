# FloCafe Environment Configuration
# Copy this file to .env and customize as needed.

# JWT secret for authentication tokens.
# If not set, FloCafe generates a random secret on first launch.
# JWT_SECRET=your-secure-random-string-here

# API server port (default: 3001)
# PORT=3001

# KDS server port (default: 3002)
# KDS_PORT=3002

# Server / waiter app port (default: 3003)
# SERVER_APP_PORT=3003

# Node environment: development, production, test (default: development)
# NODE_ENV=development

# Comma-separated browser origins allowed to call the API when they differ from
# the API origin. A same-origin deployment may set this to its public service
# URL, for example: https://your-pos.up.railway.app
# FLO_ALLOWED_ORIGINS=https://your-pos.up.railway.app

# Railway production with a Volume mounted at /data:
# FLO_DB_PATH=/data/flo.db
# Optional explicit backup directory (defaults to /data/backups when FLO_DB_PATH is set):
# FLO_BACKUP_DIR=/data/backups
# Refuse startup when the configured persistent directory is unavailable:
# FLO_REQUIRE_PERSISTENT_STORAGE=true

# One-time, host-local owner-password recovery for a headless deployment.
# Set a private random value of at least 32 characters only when recovery is needed.
# It is consumed after a successful recovery and must never be committed or shared.
# FLO_OWNER_RECOVERY_TOKEN=

# Google Drive integration for automated DB backups (#129).
# Both must be set for the "Google Drive" section under Settings >
# Integrations to be usable — if either is missing, the UI shows
# "Google Drive integration is not configured for this build" instead of a
# broken Connect button. See docs/google-drive-setup.md for how to create
# these in Google Cloud Console (APIs & Services > Credentials).
# GOOGLE_DRIVE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_DRIVE_CLIENT_SECRET=your-client-secret
